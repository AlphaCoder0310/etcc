from fastapi import FastAPI
from fastapi.responses import HTMLResponse, JSONResponse, \
    PlainTextResponse

app = FastAPI()
_CACHE = {"ts": 0.0, "payload": None}
_LOCK = threading.Lock()
_ARGS = {"demo": None, "price": None}

def get_payload(force=False):
    with _LOCK:
        now = time.time()
        if (not force and _CACHE["payload"] is not None
                and now - _CACHE["ts"] < CACHE_TTL):
            return _CACHE["payload"]
        try:
            p = scan(_ARGS["demo"], _ARGS["price"])
            _CACHE.update({"ts": now, "payload": p})
            return p
        except Exception as e:
            if _CACHE["payload"] is not None:
                p = json.loads(json.dumps(_CACHE["payload"]))
                p["meta"]["warnings"] = list(
                    p["meta"].get("warnings", [])) + [
                    f"refresh failed, showing previous data: {e}"]
                return p
            raise

@app.get("/api/scan")
def api_scan(refresh: int = 0):
    try:
        return JSONResponse(get_payload(force=bool(refresh)))
    except Exception as e:
        return JSONResponse(status_code=500,
                            content={"error": str(e)})

@app.get("/api/text")
def api_text(refresh: int = 0):
    return PlainTextResponse(text_report(
        get_payload(force=bool(refresh))))

