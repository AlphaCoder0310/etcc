@echo off
setlocal EnableDelayedExpansion
rem ====================================================
rem  run_cb_recon_web.bat -- Lagrange (CB desk web app) launcher
rem  binds 0.0.0.0:59988 -> shareable on the desk at
rem       http://apachkgfiwx507.apac.nsroot.net:59988
rem  (this machine can also use http://127.0.0.1:59988)
rem  LOGIN required: first time open /login and create a user
rem  with the desk invite code (default: citi-cb). Roles:
rem  trader = full app, sales = RFQ Station only.
rem  The app opens the browser ITSELF ~1.5s after start
rem  (FQDN-aware), so this bat no longer calls start "".
rem  ALSO auto-starts CB Nuke Station (app.py, port 59999) as a
rem  child unless one is already running.
rem  (keep this window open; Ctrl+C or closing it stops BOTH
rem  Lagrange and the auto-started Nuke Station)
rem  NEW r77: Delta Scan is EMBEDDED in-process at /dscan/
rem  (DELTA SCAN tab loads with Lagrange automatically when
rem  delta_scan_web.py sits in the same folder - no extra
rem  process, no extra port needed).
rem  requires on M:\CB\BAU:  cb_recon_web.py, recon_cb.py,
rem            load_trade_history.py, delta_check_recovered.py,
rem            delta_scan_web.py (Delta Scan),
rem            app.py (Nuke Station)
rem  FIREWALL: to share with others, allow inbound TCP 59988 on
rem  this box once (Windows will usually prompt on first run).
rem ----------------------------------------------------
rem  optional switches (remove 'rem ' to activate):
rem set NUKE_AUTOSTART=0
rem     ^ do NOT auto-start Nuke Station (two-launcher mode;
rem       use run_nuke_station.bat separately)
rem set NUKE_URL=http://SOME-HOST:59999
rem     ^ Nuke Station runs on another machine; the tab connects
rem       there and autostart is skipped automatically
rem set LAGRANGE_HOST=127.0.0.1
rem     ^ private mode: this machine only (no LAN sharing)
rem set LAGRANGE_PORT=59988
rem     ^ change the port (update the firewall rule to match)
rem set LAGRANGE_FQDN=apachkgfiwx507.apac.nsroot.net
rem     ^ hostname printed/shared and used for browser-open on
rem       the server box
rem set LAGRANGE_INVITE=citi-cb
rem     ^ the code new users must type on /login to register
rem set LAGRANGE_LIST_TTL=2.0
rem     ^ RFQ list snapshot age in seconds (one pricing pass
rem       serves all users; writes refresh it instantly)
rem set BROWSER_URL=http://127.0.0.1:59988/
rem     ^ force which URL the auto-opened browser uses
rem set DSCAN_APP=M:\CB\BAU\delta_scan_web.py
rem     ^ Delta Scan file location if not beside cb_recon_web.py
rem ====================================================
set PYTHON=C:\Users\jb33880\Anaconda3\envs\cb_runs\python.exe
set BAU=M:\CB\BAU

if not exist "%PYTHON%" (
    echo [ERROR] python not found: %PYTHON%
    pause & exit /b 1
)

set /a TRIES=0
:waitdrive
if exist "%BAU%\cb_recon_web.py" goto ready
set /a TRIES+=1
echo [%time%] waiting for %BAU%\cb_recon_web.py ... try !TRIES!/30
if !TRIES! GEQ 30 (
    echo [ERROR] file not found after 30 tries - check the drive and filename.
    pause & exit /b 9
)
timeout /t 10 /nobreak >nul
goto waitdrive
:ready

cd /d "%BAU%"
echo Starting Lagrange ...
echo    this machine : http://127.0.0.1:59988
echo    share on desk: http://apachkgfiwx507.apac.nsroot.net:59988
echo    sign in at /login  (new users: invite code citi-cb)
echo    (Nuke Station auto-starts on 59999 unless already running)
echo    (Delta Scan embedded in-process at /dscan/ - the DELTA
echo     SCAN tab loads together with Lagrange, nothing extra)
echo    (browser opens by itself in ~1.5s - no start command here)
"%PYTHON%" "%BAU%\cb_recon_web.py"
echo.
echo Server stopped.
pause
