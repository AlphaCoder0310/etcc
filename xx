          f"{os.path.abspath(__file__)}")
    print(f"  http://{a.host}:{a.port}  \u00b7 demo={bool(a.demo)}")
    print("=" * 60)
    uvicorn.run(app, host=a.host, port=a.port,
                log_level="warning")

if __name__ == "__main__":
